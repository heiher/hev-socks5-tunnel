TUNNEL_EXE_OBJS = $(OBJDIR)\tunnel-exe\hev-config.obj \
	$(OBJDIR)\tunnel-exe\hev-main.obj \
	$(OBJDIR)\tunnel-exe\hev-mapped-dns.obj \
	$(OBJDIR)\tunnel-exe\hev-socks5-session.obj \
	$(OBJDIR)\tunnel-exe\hev-socks5-session-tcp.obj \
	$(OBJDIR)\tunnel-exe\hev-socks5-session-udp.obj \
	$(OBJDIR)\tunnel-exe\hev-socks5-tunnel.obj \
	$(OBJDIR)\tunnel-exe\hev-tunnel-windows.obj \
	$(OBJDIR)\tunnel-exe\hev-exec.obj \
	$(OBJDIR)\tunnel-exe\hev-logger.obj \
	$(OBJDIR)\tunnel-exe\hev-ring-buffer.obj \
	$(OBJDIR)\tunnel-exe\hev-utils.obj \
	$(OBJDIR)\tunnel-exe\hev-wintun.obj \
	$(OBJDIR)\tunnel-exe\hev-win-compat.obj \
	$(OBJDIR)\tunnel-exe\sys_arch.obj

LIB_OBJS = $(YAML_OBJS) $(LWIP_OBJS) $(TASK_OBJS) $(CORE_OBJS) $(TUNNEL_OBJS)
EXE_OBJS = $(YAML_OBJS) $(LWIP_OBJS) $(TASK_OBJS) $(CORE_OBJS) $(TUNNEL_EXE_OBJS)

STATIC_LIB = $(DISTLIB)\hev-socks5-tunnel-static.lib
SHARED_DLL = $(DISTBIN)\hev-socks5-tunnel.dll
SHARED_LIB = $(DISTLIB)\hev-socks5-tunnel.lib
EXE = $(DISTBIN)\hev-socks5-tunnel.exe

# Public exports (no .def file in this tree, pass directly to link).
EXPORTS = /EXPORT:hev_socks5_tunnel_main \
	/EXPORT:hev_socks5_tunnel_main_from_file \
	/EXPORT:hev_socks5_tunnel_main_from_str \
	/EXPORT:hev_socks5_tunnel_quit \
	/EXPORT:hev_socks5_tunnel_stats

all : static shared exe dist

static : $(STATIC_LIB)

shared : $(SHARED_DLL)

exe : $(EXE)

dist : $(STATIC_LIB) $(SHARED_DLL) $(EXE)
	if not exist $(DISTBIN) mkdir $(DISTBIN)
	if not exist $(DISTLIB) mkdir $(DISTLIB)
	if not exist $(DISTINC) mkdir $(DISTINC)
	copy /Y $(PUBHEADER) $(DISTINC)
	if exist $(WINTUN_DLL) copy /Y $(WINTUN_DLL) $(DISTBIN)\wintun.dll
	if not exist $(DISTBIN)\wintun.dll copy /Y $(WINTUN_DLL_AMD64) $(DISTBIN)\wintun.dll

$(STATIC_LIB) : $(LIB_OBJS)
	if not exist $(DISTLIB) mkdir $(DISTLIB)
	$(AR) /NOLOGO $(MACHINE_OPT) /OUT:$@ $(LIB_OBJS)

$(SHARED_DLL) : $(LIB_OBJS)
	if not exist $(DISTBIN) mkdir $(DISTBIN)
	if not exist $(DISTLIB) mkdir $(DISTLIB)
	$(LINK) $(LINKOPTS) /DLL /OUT:$@ /IMPLIB:$(SHARED_LIB) $(LIB_OBJS) $(WINLIBS) $(EXPORTS)

$(EXE) : $(EXE_OBJS)
	if not exist $(DISTBIN) mkdir $(DISTBIN)
	$(LINK) $(LINKOPTS) /SUBSYSTEM:CONSOLE /OUT:$@ $(EXE_OBJS) $(WINLIBS)

clean :
!IF "$(ARCH_DIR)" == "x64"
	if exist $(OUTDIR)\obj rmdir /S /Q $(OUTDIR)\obj
	if exist $(OUTDIR)\dist rmdir /S /Q $(OUTDIR)\dist
!ELSE
	if exist $(OUTDIR) rmdir /S /Q $(OUTDIR)
!ENDIF

# --------------------------- inference rules ----------------------------

{third-part\yaml\src}.c{$(OBJDIR)\yaml}.obj :
	if not exist $(OBJDIR)\yaml mkdir $(OBJDIR)\yaml
	$(CC) $(CFLAGS) /Fo$@ $<

{third-part\lwip\src\core}.c{$(OBJDIR)\lwip}.obj :
	if not exist $(OBJDIR)\lwip mkdir $(OBJDIR)\lwip
	$(CC) $(CFLAGS) /Fo$@ $<

{third-part\lwip\src\core\ipv4}.c{$(OBJDIR)\lwip}.obj :
	if not exist $(OBJDIR)\lwip mkdir $(OBJDIR)\lwip
	$(CC) $(CFLAGS) /Fo$@ $<

{third-part\lwip\src\core\ipv6}.c{$(OBJDIR)\lwip}.obj :
	if not exist $(OBJDIR)\lwip mkdir $(OBJDIR)\lwip
	$(CC) $(CFLAGS) /Fo$@ $<

{third-part\lwip\src\ports\win32\lib}.c{$(OBJDIR)\tunnel}.obj :
	if not exist $(OBJDIR)\tunnel mkdir $(OBJDIR)\tunnel
	$(CC) $(CFLAGS) /Fo$@ $<

{third-part\lwip\src\ports\win32\lib}.c{$(OBJDIR)\tunnel-exe}.obj :
	if not exist $(OBJDIR)\tunnel-exe mkdir $(OBJDIR)\tunnel-exe
	$(CC) $(CFLAGS_EXE) /Fo$@ $<

