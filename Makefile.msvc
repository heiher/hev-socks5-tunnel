TUNNEL_OBJS = $(OBJDIR)\tunnel\hev-config.obj \
	$(OBJDIR)\tunnel\hev-main.obj \
	$(OBJDIR)\tunnel\hev-mapped-dns.obj \
	$(OBJDIR)\tunnel\hev-socks5-session.obj \
	$(OBJDIR)\tunnel\hev-socks5-session-tcp.obj \
	$(OBJDIR)\tunnel\hev-socks5-session-udp.obj \
	$(OBJDIR)\tunnel\hev-socks5-tunnel.obj \
	$(OBJDIR)\tunnel\hev-tunnel-windows.obj \
	$(OBJDIR)\tunnel\hev-exec.obj \
	$(OBJDIR)\tunnel\hev-logger.obj \
	$(OBJDIR)\tunnel\hev-ring-buffer.obj \
	$(OBJDIR)\tunnel\hev-utils.obj \
