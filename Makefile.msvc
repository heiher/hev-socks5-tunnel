# Makefile.msvc - Native Windows build for hev-socks5-tunnel
#
# Supported architectures: x64 (default), x86 and arm64. All compilation
# (including the GAS hev-task-execute.S) goes through clang-cl; the MSVC
# INCLUDE/LIB environment is reused unchanged.
#
# Usage (from a VS2022 Developer Command Prompt matching the target arch):
#   nmake /F Makefile.msvc                  - x64 Release, dynamic CRT (/MD)
#   nmake /F Makefile.msvc ARCH=x86         - x86 Release
#   nmake /F Makefile.msvc ARCH=arm64       - ARM64 Release
#   nmake /F Makefile.msvc DEBUG=1          - Debug, dynamic CRT (/MDd)
#   nmake /F Makefile.msvc STATIC_CRT=1     - Release, static CRT (/MT)
#   nmake /F Makefile.msvc clean            - remove build outputs for the
#                                        selected arch
#
# Outputs:
#   build-msvc[\x86|\arm64]\dist\bin\  - hev-socks5-tunnel.exe,
#                                        hev-socks5-tunnel.dll, wintun.dll
#   build-msvc[\x86|\arm64]\dist\lib\  - hev-socks5-tunnel-static.lib,
#                                        hev-socks5-tunnel.lib (import)
#   build-msvc[\x86|\arm64]\dist\include\ - public header (hev-main.h)

PROJECT = hev-socks5-tunnel
OUTDIR = build-msvc
OBJDIR = $(OUTDIR)\obj
DISTDIR = $(OUTDIR)\dist
DISTBIN = $(DISTDIR)\bin
DISTLIB = $(DISTDIR)\lib
DISTINC = $(DISTDIR)\include

# The bundled wintun redistributable ships one DLL per architecture; the
# per-arch selection happens in the ARCH block below.
WINTUN_DLL_AMD64 = third-part\wintun\bin\wintun.dll
WINTUN_DLL_X86 = third-part\wintun\bin\wintun-x86.dll
WINTUN_DLL_ARM64 = third-part\wintun\bin\wintun-arm64.dll
PUBHEADER = src\hev-main.h
COMPAT_HEADER = third-part\hev-task-system\win32-compat\hev-win-compat.h

CC = clang-cl
# Named AR (not LIB) so it cannot clobber the LIB environment variable,
# which NMAKE exports to child processes and link.exe needs to find CRT/SDK libs.
AR = lib
LINK = link

# ------------------------ architecture selection ------------------------
!IF "$(ARCH)" == "x86"
ARCH_DIR = x86
CLANG_TARGET = i686-pc-windows-msvc
WINTUN_DLL = $(WINTUN_DLL_X86)
!ELSEIF "$(ARCH)" == "arm64"
ARCH_DIR = arm64
CLANG_TARGET = aarch64-pc-windows-msvc
WINTUN_DLL = $(WINTUN_DLL_ARM64)
!ELSEIF "$(ARCH)" == "x64" || !DEFINED(ARCH)
ARCH_DIR = x64
CLANG_TARGET = x86_64-pc-windows-msvc
WINTUN_DLL = $(WINTUN_DLL_AMD64)
!ELSE
!ERROR Unknown ARCH "$(ARCH)". Use x64 (default), x86 or arm64.
!ENDIF

# Explicit /MACHINE for lib and link: their default target machine depends
# on the developer environment and can disagree with ARCH in cross setups.
!IF "$(ARCH_DIR)" == "x86"
MACHINE_OPT = /MACHINE:X86
!ELSEIF "$(ARCH_DIR)" == "arm64"
MACHINE_OPT = /MACHINE:ARM64
!ELSE
MACHINE_OPT = /MACHINE:X64
!ENDIF

# Keep the established x64 output paths; x86 and arm64 build into
# subfolders so no architecture overwrites another's artifacts.
!IF "$(ARCH_DIR)" != "x64"
OUTDIR = build-msvc\$(ARCH_DIR)
!ENDIF

!IF DEFINED(DEBUG)
CFLAGS_EXTRA = /Od /Zi /MDd
!ELSEIF DEFINED(STATIC_CRT)
CFLAGS_EXTRA = /O2 /MT
!ELSE
CFLAGS_EXTRA = /O2 /MD
!ENDIF

CFLAGS = /nologo /c /W4 /utf-8 /std:c11 -Xclang -std=gnu11 $(CFLAGS_EXTRA) \
	--target=$(CLANG_TARGET) -Wno-unused-command-line-argument \
	/DENABLE_LIBRARY \
	/D_CRT_SECURE_NO_WARNINGS \
	/D_CRT_NONSTDC_NO_WARNINGS \
	/DHAVE_CONFIG_H=0 \
	/DYAML_DECLARE_STATIC \
	/DYAML_VERSION_MAJOR=0 \
	/DYAML_VERSION_MINOR=2 \
	/DYAML_VERSION_PATCH=5 \
	/DYAML_VERSION_STRING=\"0.2.5\" \
	/DSSIZE_MAX=INT_MAX \
	/DENABLE_MEMALLOC_SLICE \
	/DENABLE_STACK_OVERFLOW_DETECTION \
	/DCOMMIT_ID=\"unknown\" \
	/DCONFIG_STACK_BACKEND=STACK_HEAP \
	/DCONFIG_STACK_OVERFLOW_DETECTION=1 \
	/DCONFIG_MEMALLOC_SLICE_ALIGN=16 \
	/DCONFIG_MEMALLOC_SLICE_MAX_SIZE=4096 \
	/DCONFIG_MEMALLOC_SLICE_MAX_COUNT=1000 \
	/DCONFIG_SCHED_CLOCK=CLOCK_NONE \
	/Isrc \
	/Isrc\misc \
	/Isrc\core\include \
	/Ithird-part\yaml\include \
	/Ithird-part\lwip\src\include \
	/Ithird-part\lwip\src\ports\include \
	/Ithird-part\hev-task-system\include \
	/Ithird-part\hev-task-system\src \
	/Ithird-part\hev-task-system\win32-compat \
	/Ithird-part\hev-task-system\win32-compat\include \
	/Ithird-part\wintun\include \
	/FIhev-win-compat.h

# Same as CFLAGS but without /DENABLE_LIBRARY, so hev-main.c gets main().
CFLAGS_EXE = /nologo /c /W4 /utf-8 /std:c11 -Xclang -std=gnu11 $(CFLAGS_EXTRA) \
	--target=$(CLANG_TARGET) -Wno-unused-command-line-argument \
	/D_CRT_SECURE_NO_WARNINGS \
	/D_CRT_NONSTDC_NO_WARNINGS \
	/DHAVE_CONFIG_H=0 \
	/DYAML_DECLARE_STATIC \
	/DYAML_VERSION_MAJOR=0 \
	/DYAML_VERSION_MINOR=2 \
	/DYAML_VERSION_PATCH=5 \
	/DYAML_VERSION_STRING=\"0.2.5\" \
	/DSSIZE_MAX=INT_MAX \
	/DENABLE_MEMALLOC_SLICE \
	/DENABLE_STACK_OVERFLOW_DETECTION \
	/DCOMMIT_ID=\"unknown\" \
	/DCONFIG_STACK_BACKEND=STACK_HEAP \
	/DCONFIG_STACK_OVERFLOW_DETECTION=1 \
	/DCONFIG_MEMALLOC_SLICE_ALIGN=16 \
	/DCONFIG_MEMALLOC_SLICE_MAX_SIZE=4096 \
	/DCONFIG_MEMALLOC_SLICE_MAX_COUNT=1000 \
	/DCONFIG_SCHED_CLOCK=CLOCK_NONE \
	/Isrc \
	/Isrc\misc \
	/Isrc\core\include \
	/Ithird-part\yaml\include \
	/Ithird-part\lwip\src\include \
	/Ithird-part\lwip\src\ports\include \
	/Ithird-part\hev-task-system\include \
	/Ithird-part\hev-task-system\src \
	/Ithird-part\hev-task-system\win32-compat \
	/Ithird-part\hev-task-system\win32-compat\include \
	/Ithird-part\wintun\include \
	/FIhev-win-compat.h

WINLIBS = Ws2_32.lib Iphlpapi.lib Advapi32.lib
SDK_LIBPATH = $(WindowsSdkDir)Lib\$(WindowsSDKVersion)um\$(ARCH_DIR)
# /CETCOMPAT is x64/x86 only; ARM64 has no CET shadow stack.
!IF "$(ARCH_DIR)" == "arm64"
CET_OPT =
!ELSE
CET_OPT = /CETCOMPAT:NO
!ENDIF
LINKOPTS = /NOLOGO $(CET_OPT) $(MACHINE_OPT) /LIBPATH:"$(SDK_LIBPATH)" /LIBPATH:"C:\Program Files (x86)\Windows Kits\10\Lib\10.0.26100.0\um\$(ARCH_DIR)" /LIBPATH:"C:\Program Files (x86)\Windows Kits\10\Lib\10.0.22621.0\um\$(ARCH_DIR)"

# ------------------------------- sources --------------------------------

